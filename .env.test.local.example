# Copier en .env.test.local (gitignoré) pour scripts/test-functions.sh
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<clé anon publique, dashboard > Project Settings > API>

# Compte de test créé dans Auth > Users
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=
# id du user, visible dans Auth > Users
TEST_USER_ID=

# Même valeur que le secret posé via `supabase secrets set`
PAYMENT_WEBHOOK_SECRET=
