# Copier en .env (gitignoré). Les deux valeurs sont publiques côté client :
# la clé anon est protégée par les policies RLS, pas par le secret.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clé anon, dashboard > Project Settings > API>

# Clés SDK publiques RevenueCat (dashboard > Project settings > API keys).
# Publiques par conception : les achats sont validés par les stores, pas par
# ces clés. Sans elles, le paywall affiche des prix indicatifs non achetables.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
